#!/usr/bin/env php
<?php

declare(strict_types=1);

// Find autoloader
if (\Phar::running() !== '') {
    // Running as PHAR
    require 'phar://sputnik.phar/vendor/autoload.php';
} else {
    // Running from source
    $autoloadPaths = [
        __DIR__ . '/../vendor/autoload.php',           // Local development
        __DIR__ . '/../../../autoload.php',            // Installed as dependency
    ];

    $autoloadPath = null;
    foreach ($autoloadPaths as $path) {
        if (file_exists($path)) {
            $autoloadPath = $path;
            break;
        }
    }

    if ($autoloadPath === null) {
        fwrite(STDERR, "Could not find autoloader. Run 'composer install' first.\n");
        exit(1);
    }

    require $autoloadPath;
}

use Sputnik\Kernel;
use Symfony\Component\Console\Output\ConsoleOutput;

// Determine working directory
$workingDir = getcwd();

// Check for --working-dir option
$args = $_SERVER['argv'];
foreach ($args as $i => $arg) {
    if (str_starts_with($arg, '--working-dir=')) {
        $workingDir = substr($arg, 14);
        unset($args[$i]);
        $_SERVER['argv'] = array_values($args);
        break;
    }
    if ($arg === '--working-dir' && isset($args[$i + 1])) {
        $workingDir = $args[$i + 1];
        unset($args[$i], $args[$i + 1]);
        $_SERVER['argv'] = array_values($args);
        break;
    }
}

// Make the project root the working directory of the process, so a task doing
// its own file I/O sees the same place its commands run in. Until now exec() ran
// in the project root while file_exists() in the task resolved against the
// caller's cwd, which is why a wrapper had to cd before calling the binary.
//
// Resolving to an absolute path first is not cosmetic: a relative
// --working-dir would otherwise be looked up inside itself after the chdir.
// It also keeps the container cache key stable, which includes this path.
if ($workingDir === false || !is_dir($workingDir)) {
    fwrite(\STDERR, \sprintf(
        "Working directory does not exist: %s\n",
        $workingDir === false ? '(could not be determined)' : $workingDir,
    ));

    exit(1);
}

$resolvedWorkingDir = realpath($workingDir);

if ($resolvedWorkingDir === false || !@chdir($resolvedWorkingDir)) {
    fwrite(\STDERR, 'Could not enter working directory: ' . $workingDir . "\n");

    exit(1);
}

$workingDir = $resolvedWorkingDir;

// Check for --context option
$contextOverride = null;
$args = $_SERVER['argv'];
foreach ($args as $i => $arg) {
    if (str_starts_with($arg, '--context=')) {
        $contextOverride = substr($arg, 10);
        unset($args[$i]);
        $_SERVER['argv'] = array_values($args);
        break;
    }
    if ($arg === '--context' && isset($args[$i + 1])) {
        $contextOverride = $args[$i + 1];
        unset($args[$i], $args[$i + 1]);
        $_SERVER['argv'] = array_values($args);
        break;
    }
}

// Create output for streaming
$output = new ConsoleOutput();

// Bootstrap and run
try {
    $kernel = new Kernel(workingDir: $workingDir, contextName: $contextOverride);
    $output = new Sputnik\Secret\RedactingConsoleOutput($output, $kernel->getSecretRedactor());

    // Everything that writes shares this destination: tasks, the commands, and
    // the listeners they fire - which run outside any task and would otherwise
    // have no output at all.
    $kernel->getOutputChannel()->set($output);
    $app = $kernel->createApplication($output);
    // Symfony's default autoExit would call exit() inside run(), so the
    // one-shot context re-render below would never execute.
    $app->setAutoExit(false);
    $exitCode = $app->run(null, $output);

    // Re-render templates with the persisted context if --context was a one-shot override
    if ($contextOverride !== null) {
        $persistedContext = $kernel->getContextManager()->getCurrentContext();
        if ($persistedContext !== $contextOverride) {
            // The resolver must switch too, or {{ context }} and every
            // context-level constant still render with the override.
            $kernel->getVariableResolver()->switchContext($persistedContext);
            $kernel->getTemplateEngine()->switchContext($persistedContext);
            $kernel->getTemplateEngine()->renderAll(force: true);

            // This render runs outside any TaskRunner::run() call, so nothing
            // else drains a secret that failed to resolve while rendering.
            foreach ($kernel->getSecretRegistry()->takeDiagnostics() as $diagnostic) {
                $output->writeln('<comment>' . $diagnostic . '</comment>');
            }
        }
    }

    exit($exitCode);
} catch (Sputnik\Exception\SputnikException $e) {
    $output->writeln('<error> Error: ' . $e->getMessage() . ' </error>');
    exit(1);
} catch (Throwable $e) {
    $output->writeln('<error> Fatal error: ' . $e->getMessage() . ' </error>');
    if (in_array('-v', $_SERVER['argv'], true) || in_array('--verbose', $_SERVER['argv'], true)) {
        $output->writeln($e->getTraceAsString());
    }
    exit(1);
}
